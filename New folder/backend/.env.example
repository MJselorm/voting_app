# ──────────────────────────────────────────────
# Backend environment variables — EXAMPLE FILE
# Copy this to .env and fill in your values.
# NEVER commit the real .env file to Git.
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Supabase PostgreSQL connection string.
# Use the "Transaction" or "Session" mode URI from Supabase dashboard.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Firebase Admin SDK ────────────────────────
# These values come from the Firebase service account JSON.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# IMPORTANT: The private key contains newlines.
# When pasting into .env, replace actual newlines with \n and wrap in double quotes.
# Example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# ── App ───────────────────────────────────────
APP_ENV=development
