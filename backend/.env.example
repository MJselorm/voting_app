DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
FIREBASE_PROJECT_ID=your-firebase-project-id
# For local development, set GOOGLE_APPLICATION_CREDENTIALS to a private service-account JSON file.
# In production, prefer the platform's workload identity or inject FIREBASE_SERVICE_ACCOUNT_JSON as a secret.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
# Configure a transactional SMTP sender before enabling membership email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
